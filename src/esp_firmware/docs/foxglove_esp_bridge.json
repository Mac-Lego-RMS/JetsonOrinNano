    "Teleop!drive": {
      "topic": "/cmd_vel",
      "publishRate": 10,
      "upButton": {
        "field": "linear-x",
        "value": 0.5
      },
      "downButton": {
        "field": "linear-x",
        "value": -0.5
      },
      "leftButton": {
        "field": "angular-z",
        "value": 1
      },
      "rightButton": {
        "field": "angular-z",
        "value": -1
      }
    },
    "Publish!stop": {
      "topicName": "/esp_serial_bridge/emergency",
      "datatype": "std_msgs/msg/Empty",
      "schemaName": "std_msgs/msg/Empty",
      "buttonText": "NOTHALT",
      "buttonTooltip": "Bremse aktiv, bricht auch eine Positionsfahrt ab",
      "buttonColor": "#d9534f",
      "advancedView": false,
      "value": "{}"
    },
    "Publish!move": {
      "topicName": "/esp_serial_bridge/move",
      "datatype": "std_msgs/msg/Float32",
      "schemaName": "std_msgs/msg/Float32",
      "buttonText": "Fahrt starten",
      "buttonTooltip": "Grad RELATIV zur jetzigen Stellung",
      "buttonColor": "#4e98e2",
      "advancedView": true,
      "value": "{\n  \"data\": 90.0\n}"
    },
    "Plot!tempo": {
      "title": "Tempo & Duty",
      "paths": [
        {
          "value": "/esp_serial_bridge/speed.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "Tempo [Grad/s]",
          "color": "#4e98e2",
          "lineSize": 1.5,
          "showLine": true
        },
        {
          "value": "/esp_serial_bridge/motor_state.data[0]",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "Duty [-1023..1023]",
          "color": "#f5774d",
          "lineSize": 1.5,
          "showLine": true
        }
      ],
      "xAxisVal": "timestamp",
      "followingViewWidth": 30,
      "isSynced": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "sidebarDimension": 240
    },
    "Plot!stellung": {
      "title": "Stellung der Ausgangswelle",
      "paths": [
        {
          "value": "/esp_serial_bridge/joint_states.position[0]",
          "enabled": true,
          "timestampMethod": "headerStamp",
          "label": "Stellung [rad]",
          "color": "#7ac74f",
          "lineSize": 1.5,
          "showLine": true
        },
        {
          "value": "/esp_serial_bridge/joint_states.velocity[0]",
          "enabled": true,
          "timestampMethod": "headerStamp",
          "label": "Tempo [rad/s]",
          "color": "#c95fd6",
          "lineSize": 1.5,
          "showLine": true
        }
      ],
      "xAxisVal": "timestamp",
      "followingViewWidth": 30,
      "isSynced": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "sidebarDimension": 240
    },
    "Gauge!strom": {
      "path": "/esp_serial_bridge/motor_state.data[1]",
      "minValue": 0,
      "maxValue": 12,
      "colorMode": "colormap",
      "colorMap": "red-yellow-green",
      "gradient": [
        "#0000ff",
        "#ff00ff"
      ],
      "reverse": true
    },
    "Plot!latenz": {
      "title": "Latenz je Paket [ms]",
      "paths": [
        {
          "value": "/esp_serial_bridge/latency_ms.data",
          "enabled": true,
          "timestampMethod": "receiveTime",
          "label": "abgeschickt -> gelesen",
          "color": "#4e98e2",
          "lineSize": 1.5,
          "showLine": true
        }
      ],
      "minYValue": 0,
      "xAxisVal": "timestamp",
      "followingViewWidth": 60,
      "isSynced": true,
      "showLegend": true,
      "legendDisplay": "floating",
      "showPlotValuesInLegend": true,
      "showXAxisLabels": true,
      "showYAxisLabels": true,
      "sidebarDimension": 240
    },
