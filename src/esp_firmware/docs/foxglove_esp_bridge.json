    "Indicator!akkuwarn": {
      "path": "/esp_serial_bridge/battery_low.data",
      "style": "bulb",
      "fallbackColor": "#4caf50",
      "fallbackLabel": "Akku in Ordnung",
      "rules": [
        {
          "operator": "=",
          "rawValue": "true",
          "color": "#d9534f",
          "label": "UNTERSPANNUNG - der ESP schaltet NICHT ab"
        }
      ]
    },
